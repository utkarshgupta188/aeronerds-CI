[Unit]
Description=Bhumi Vikas Sahayak FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/aeronerds-CI
EnvironmentFile=/home/ubuntu/aeronerds-CI/.env
# Port 8010, not 8000: another app on the shared EC2 host already owns 8000.
ExecStart=/home/ubuntu/aeronerds-CI/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
